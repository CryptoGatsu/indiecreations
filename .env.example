# Optional override for the $creations contract address. The live CA is already
# the default in lib/config.js: 0xB9195597f91f179EBB05D3F1765B35C3d8491aCb
NEXT_PUBLIC_TOKEN_ADDRESS=

# Whole tokens a wallet must hold to unlock the playtest area.
NEXT_PUBLIC_MIN_TOKENS=5000000

# Long random string used to sign holder sessions. REQUIRED in production.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional: private RPC for server-side balance checks (the public one is rate-limited).
# e.g. https://robinhood-mainnet.g.alchemy.com/v2/<key>
RPC_URL=

# Optional: enables WalletConnect (mobile wallets). Free id from https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# REQUIRED once a Unity build with the in-game holder check is live (Project TJR): signs the short-lived
# tickets the game asks for at /api/game/ticket. Base64 of an RSA-2048 private key in PEM (PKCS#8) form.
# The matching PUBLIC key is compiled into the game (HolderGate.cs) - they must be the same pair.
GAME_TICKET_KEY=

# Optional: extra wallets that may enter the playtest area without holding the minimum (comma separated).
# The dev wallet is already allowlisted in lib/config.js. They still sign in with their wallet like everyone else.
ALLOWLIST_WALLETS=

# Optional but recommended: keeps holder reviews in Supabase instead of memory (memory is wiped on every deploy).
# Create the table with supabase/feedback.sql. The service-role key is SERVER-ONLY - never prefix it NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
