# Optional override for the $CREATIONS contract address. The live CA is already
# the default in lib/config.js: 0xB9195597f91f179EBB05D3F1765B35C3d8491aCb
NEXT_PUBLIC_TOKEN_ADDRESS=

# Whole tokens a wallet must hold to unlock the playtest area.
NEXT_PUBLIC_MIN_TOKENS=1

# Long random string used to sign holder sessions. REQUIRED in production.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Recommended: private RPC (e.g. QuickNode) for everything the server does on-chain: balance checks, the revenue
# share's daily job and publishing payouts. The public RPC rate-limits Vercel's shared servers. SERVER-ONLY.
RPC_URL=
# Optional: RPC for the daily job's transfer log queries. Defaults to the public RPC, which allows a query over the
# whole chain at once (private RPCs often cap a query at a few thousand blocks).
LOGS_RPC_URL=
# Optional: JSON-RPC calls per second each server instance sends (default 25; QuickNode's plan allows 50).
RPC_MAX_RPS=

# Optional: enables WalletConnect (mobile wallets). Free id from https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# REQUIRED once a Unity build with the in-game holder check is live (Project TJR): signs the short-lived
# tickets the game asks for at /api/game/ticket. Base64 of an RSA-2048 private key in PEM (PKCS#8) form.
# The matching PUBLIC key is compiled into the game (HolderGate.cs) - they must be the same pair.
GAME_TICKET_KEY=

# Optional: extra wallets that may enter the playtest area without holding the minimum (comma separated).
# The dev wallet is already allowlisted in lib/config.js. They still sign in with their wallet like everyone else.
ALLOWLIST_WALLETS=

# Optional but recommended: keeps holder reviews in Supabase instead of memory (memory is wiped on every deploy).
# Create the table with supabase/feedback.sql. The service-role key is SERVER-ONLY - never prefix it NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cosmetics shop ---------------------------------------------------------------------------------------------
# Checkout needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above (tables: supabase/shop.sql); without them the shop
# is browse-only in production.
# Optional override for the wallet that receives $CREATIONS payments. The live treasury is already the default in
# lib/shop.js: 0x901fC42f24adc138F73BaC931557Ab17AfCA7093
SHOP_TREASURY_ADDRESS=

# Recommended in production: the site's own address, so "Sign in through Steam" always returns here.
# e.g. https://www.indiecreations.fun
SITE_URL=

# Optional: Steam Web API key (https://steamcommunity.com/dev/apikey) for names / avatars. Works without it.
STEAM_WEB_API_KEY=

# Once a game has a Steam app: its app id + a Steamworks PUBLISHER Web API key. With both set, /api/game/cosmetics
# only answers a game that proves its Steam account with a session ticket. SERVER-ONLY, never NEXT_PUBLIC_.
STEAM_APP_ID=
STEAM_PUBLISHER_KEY=

# Local development only: SHOP_DEMO=1 shows a few sample items so the shop can be worked on. Ignored in production.
SHOP_DEMO=

# --- Holder revenue share (see README) ---------------------------------------------------------------------------
# The deployed RevenueShare contract. Until set, /rewards explains the programme with nothing to claim.
NEXT_PUBLIC_REVSHARE_ADDRESS=
# Revenue in US dollars that must build up before a payout; below it, months carry over. Default 100.
NEXT_PUBLIC_REVSHARE_MIN_USD=
# First month that pays out, YYYY-MM. Nothing is paid until this is set.
REVSHARE_START_MONTH=
# Block $CREATIONS was deployed in: where the transfer copy starts.
REVSHARE_FROM_BLOCK=
# SERVER-ONLY private key of the publisher wallet (the contract's owner). Needs a little ETH for gas. Never NEXT_PUBLIC_.
REVSHARE_PUBLISHER_KEY=
# Optional, comma separated: wallets that never earn / contract wallets that should earn anyway.
REVSHARE_EXCLUDE=
REVSHARE_INCLUDE=
# Long random string. Vercel Cron sends it to /api/cron/revshare; nothing else can run the job without it.
CRON_SECRET=
# Optional, comma separated: extra wallets allowed into /admin (the treasury and the dev wallet always are).
ADMIN_WALLETS=

# --- Community games (/create, /community) -------------------------------------------------------------------------
# Needs ANTHROPIC_API_KEY (SERVER-ONLY) and the tables in supabase/creations.sql. Without the key, creation is off.
ANTHROPIC_API_KEY=
# Optional: generations (new games + changes) per wallet per 24 hours, and for the whole site. Defaults 15 and 400.
CREATIONS_PER_DAY=
CREATIONS_SITE_PER_DAY=
# Optional: the Claude model and effort used to write games. Defaults claude-opus-5-5 and medium.
CREATIONS_MODEL=
CREATIONS_EFFORT=
